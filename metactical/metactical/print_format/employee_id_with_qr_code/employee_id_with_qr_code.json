 "html": "<div style=\"width: 300px; height: 450px; border: 2px solid #000; border-radius: 12px; overflow: hidden; text-align: center; position: relative;\">\n\n  <div style=\"background-color: #1E3A8A; height: 50%; padding-top: 30px; position: relative; font-size: 20px; font-weight: bold;\">\n\n    <div style=\"position: absolute; bottom: -50px; left: 50%; transform: translateX(-50%); width: 180px; height: 200px;\">\n      {% if doc.image %}\n        <img src=\"{{ doc.image }}\" style=\"width: 180px; height: 200px; object-fit: cover; border: 2px solid #ccc; border-radius: 6px;\">\n      {% elif doc.gender == \"Male\" %}\n        <img src=\"{{ frappe.utils.get_url('/assets/metactical/img/male.jpg') }}\" style=\"width: 180px; height: 200px; object-fit: cover; border: 2px solid #ccc; border-radius: 6px;\">\n      {% else %}\n        <img src=\"{{ frappe.utils.get_url('/assets/metactical/img/female.jpg') }}\" style=\"width: 180px; height: 200px; object-fit: cover; border: 2px solid #ccc; border-radius: 6px;\">      {% endif %}\n    </div>\n  </div>\n\n  <div style=\"height: 60px;\"></div>\n\n  <div style=\"font-size: 18px; font-weight: bold; margin: 12px;\">\n    {{ doc.employee_name }}\n  </div>\n  \n  <div style='text-align: center; padding:0 15px'>\n      {% set pin = frappe.get_doc(\"POS User Settings\", doc.user_id) %}\n      {% if pin and doc.short_code %}\n            {% set pin = get_password(pin) %}\n            <img alt='{{ doc.name }}'\n                src='https://barcode.tec-it.com/barcode.ashx?data={{ doc.short_code+\"-\"+pin }}&code=QRCode&eclevel=M'/>\n        {% elif not pin %}\n            <center>PIN is Not Set</center>\n        {% elif not doc.short_code %}\n            <center>Short Code is Not Set</center>\n        {% endif %}\n  </div>\n</div>\n",
