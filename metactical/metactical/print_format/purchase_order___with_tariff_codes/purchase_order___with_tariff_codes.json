 "format_data": "[{\"fieldname\": \"print_heading_template\", \"fieldtype\": \"Custom HTML\", \"options\": \"<div class=\\\"row\\\"> \\n    <div class=\\\"col-md-6\\\"><img src=\\\"/files/logo.jpg\\\" width=\\\"70%\\\"></div>\\n    <div class=\\\"col-md-6\\\">{{doc.company_address_display}}</div>\\n</div>\\n \"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"{{get_commercial_invoice(doc)}}\"}]",
 "html": "<div style=\"font-family: 'Segoe UI', sans-serif; width: 100%; font-size: 13px\">\n      {% set company = frappe.get_doc(\"Company\", doc.company) %}\n\n      <!-- ========== PAGE 1: MAIN PURCHASE ORDER / INVOICE ========== -->\n      <div style=\"page-break-after: always\">\n            <!-- Header -->\n            <div\n                  style=\"\n                        display: flex;\n                        justify-content: space-between;\n                        align-items: flex-start;\n                  \"\n            >\n                  <div>\n                        {% if company.company_logo %}\n                        <img\n                              src=\"{{ company.company_logo }}\"\n                              style=\"height: 70px\"\n                        />\n                        {% endif %}\n                  </div>\n                  <div>\n                        <p style=\"margin: 0\">{{ company.website }}</p>\n                        <p style=\"margin: 0\">Phone: {{ company.phone_no }}</p>\n                        <p style=\"margin: 0\">Fax: {{ company.fax }}</p>\n                        <p style=\"margin: 0\">Email: {{ company.email }}</p>\n                  </div>\n                  <div></div>\n                  <div></div>\n                  <div></div>\n                  <div></div>\n            </div>\n\n            <br />\n\n            <div\n                  style=\"\n                        display: flex;\n                        justify-content: space-between;\n                        align-items: flex-start;\n                  \"\n            >\n                  <div></div>\n                  <div>\n                        <h2><b>Invoice</b></h2>\n                  </div>\n                  <div>\n                        <h2><b>Export</b></h2>\n                  </div>\n            </div>\n\n            <br />\n\n            <!--# Try to find the Purchase Invoice linked to this Purchase Order-->\n            {% set invoice = frappe.db.get_value( \"Purchase Invoice Item\", {\"purchase_order\": doc.name}, \"parent\" ) %}\n\n            <div\n                  style=\"\n                        display: flex;\n                        justify-content: space-between;\n                        align-items: flex-start;\n                  \"\n            >\n                  <div style=\"text-align: left\">\n                        {% if invoice %} \n                        {% set inv = frappe.get_doc(\"Purchase Invoice\", invoice) %}\n                        <p><b>Invoice Number:</b> {{ inv.name }}</p>\n                        <p>\n                              <b>Invoice Date:</b> {{\n                              frappe.format_date(inv.posting_date) }}\n                        </p>\n                        <p>\n                              <b>Payment Terms:</b> {{\n                              inv.payment_terms_template or \"-\" }}\n                        </p>\n                        <p>\n                              <b>Due Date:</b> {{\n                              frappe.format_date(inv.due_date) if inv.due_date\n                              else \"-\" }}\n                        </p>\n                        {% else %}\n                        <p><b>Invoice:</b> Not yet created</p>\n                        {% endif %}\n                  </div>\n            </div>\n\n            <br>\n            \n            <!-- Addresses -->\n            <div\n                  style=\"\n                        display: flex;\n                        justify-content: space-between;\n                        align-items: flex-start;\n                  \"\n            >\n                  <div>\n                        <u><b>Sold To</b></u\n                        ><br />\n                        <p style=\"margin: 0\">\n                              {{ doc.supplier_address or '' }}\n                        </p>\n                        <br />\n                        <p><b>Order Number(s):</b> {{ doc.name }}</p>\n                        <p>\n                              <b>Tracking Number:</b> {{ doc.tracking_id or '\u2014'\n                              }}\n                        </p>\n                        <p>\n                              <b>Customer PO(s):</b> {{ doc.tracking_id or '\u2014'\n                              }}\n                        </p>\n                  </div>\n                  <div>\n                        <u><b>Shipped To</b></u\n                        ><br />\n                        <p style=\"margin: 0\">\n                              {{ doc.shipping_address_display or '' }}\n                        </p>\n                        <br />\n                        <p><b>Ship Via:</b> {{ doc.carrier_used or '\u2014' }}</p>\n                        <p>\n                              <b>Freight Terms:</b> {{ doc.freight_terms or '\u2014'\n                              }}\n                        </p>\n                        <p>\n                              <b>Sales Agent:</b> {{ doc.freight_terms or '\u2014' }}\n                        </p>\n                  </div>\n            </div>\n\n            <!-- Items Table -->\n            <table\n                  style=\"\n                        width: 100%;\n                        border-collapse: collapse;\n                        margin-top: 8px;\n                  \"\n            >\n                  <thead>\n                        <tr style=\"background-color: #f2f2f2\">\n                              <th style=\"border: 1px solid #ccc; padding: 4px\">\n                                    Ctn.\n                              </th>\n                              <th style=\"border: 1px solid #ccc; padding: 4px\">\n                                    Item Description\n                              </th>\n                              <th style=\"border: 1px solid #ccc; padding: 4px\">\n                                    Qty Shipped\n                              </th>\n                              <th style=\"border: 1px solid #ccc; padding: 4px\">\n                                    Qty B/O\n                              </th>\n                              <th style=\"border: 1px solid #ccc; padding: 4px\">\n                                    UM\n                              </th>\n                              <th style=\"border: 1px solid #ccc; padding: 4px\">\n                                    Weight Per Unit\n                              </th>\n                              <th style=\"border: 1px solid #ccc; padding: 4px\">\n                                    C.O\n                              </th>\n                              <th style=\"border: 1px solid #ccc; padding: 4px\">\n                                    Unit Price\n                              </th>\n                              <th style=\"border: 1px solid #ccc; padding: 4px\">\n                                    Extended Amount\n                              </th>\n                        </tr>\n\n                        <!-- Disclaimer Row (Full Width) -->\n                        <tr>\n                              <td\n                                    colspan=\"9\"\n                                    style=\"\n                                          border: 1px solid #ccc;\n                                          padding: 6px;\n                                          font-size: 11px;\n                                          color: #444;\n                                          background-color: #fafafa;\n                                          text-align: center;\n                                    \"\n                              >\n                                    <strong>NO LICENSE REQUIRED</strong><br />\n                                    These items are controlled by the U.S.\n                                    government and authorized for export only to\n                                    the country of ultimate destination for use\n                                    by the ultimate consignee or end-user(s)\n                                    herein identified. They may not be resold,\n                                    transferred, or otherwise disposed of to any\n                                    other country or to any person other than\n                                    the authorized ultimate consignee or\n                                    end-user(s), either in their original form\n                                    or after being incorporated into other\n                                    items, without first obtaining approval from\n                                    the U.S. government or as otherwise\n                                    authorized by U.S. law and regulations.\n                              </td>\n                        </tr>\n                  </thead>\n\n                  <tbody>\n                        {% for item in doc.items %} {% set item_doc =\n                        frappe.get_doc(\"Item\", item.item_code) %}\n                        <tr>\n                              <td style=\"border: 1px solid #ccc; padding: 4px\">\n                                    1\n                              </td>\n                              <td style=\"border: 1px solid #ccc; padding: 4px\">\n                                    {{ item.description }}\n                              </td>\n                              <td\n                                    style=\"\n                                          border: 1px solid #ccc;\n                                          padding: 4px;\n                                          text-align: right;\n                                    \"\n                              >\n                                    {{ item.qty }}\n                              </td>\n                              <td\n                                    style=\"\n                                          border: 1px solid #ccc;\n                                          padding: 4px;\n                                          text-align: right;\n                                    \"\n                              >\n                                    {{ item.qty }}\n                              </td>\n                              <td\n                                    style=\"\n                                          border: 1px solid #ccc;\n                                          padding: 4px;\n                                          text-align: center;\n                                    \"\n                              >\n                                    {{ item.uom }}\n                              </td>\n                              <td\n                                    style=\"\n                                          border: 1px solid #ccc;\n                                          padding: 4px;\n                                          text-align: right;\n                                    \"\n                              >\n                                    {{ item_doc.weight_per_unit or '' }}\n                              </td>\n                              <td\n                                    style=\"\n                                          border: 1px solid #ccc;\n                                          padding: 4px;\n                                          text-align: right;\n                                    \"\n                              >\n                                    {{ item_doc.country_of_origin or '' }}\n                              </td>\n                              <td\n                                    style=\"\n                                          border: 1px solid #ccc;\n                                          padding: 4px;\n                                          text-align: right;\n                                    \"\n                              >\n                                    {{ frappe.format_value(item.net_rate,\n                                    {'fieldtype': 'Currency'}) }}\n                              </td>\n                              <td\n                                    style=\"\n                                          border: 1px solid #ccc;\n                                          padding: 4px;\n                                          text-align: right;\n                                    \"\n                              >\n                                    {{ frappe.format(item.net_amount,\n                                    {'fieldtype':'Currency'}) }}\n                              </td>\n                        </tr>\n                        {% endfor %}\n                  </tbody>\n            </table>\n      </div>\n      <!-- End of PAGE 1 -->\n\n      <!-- ========== PAGE 2: SUMMARY AND DISCLAIMERS ========== -->\n      <div style=\"page-break-after: always; margin-top: 20px\">\n            <!-- Header -->\n            <div\n                  style=\"\n                        display: flex;\n                        justify-content: space-between;\n                        align-items: flex-start;\n                  \"\n            >\n                  <div>\n                        {% if company.company_logo %}\n                        <img\n                              src=\"{{ company.company_logo }}\"\n                              style=\"height: 70px\"\n                        />\n                        {% endif %}\n                  </div>\n                  <div>\n                        <p style=\"margin: 0\">{{ company.website }}</p>\n                        <p style=\"margin: 0\">Phone: {{ company.phone_no }}</p>\n                        <p style=\"margin: 0\">Fax: {{ company.fax }}</p>\n                        <p style=\"margin: 0\">Email: {{ company.email }}</p>\n                  </div>\n                  <div></div>\n                  <div></div>\n                  <div></div>\n                  <div></div>\n            </div>\n\n            <br />\n\n            <div\n                  style=\"\n                        display: flex;\n                        justify-content: space-between;\n                        align-items: flex-start;\n                  \"\n            >\n                  <div></div>\n                  <div>\n                        <h2><b>Invoice</b></h2>\n                  </div>\n                  <div>\n                        <h2><b>Export</b></h2>\n                  </div>\n            </div>\n\n            <br />\n\n            <!--# Try to find the Purchase Invoice linked to this Purchase Order-->\n            {% set invoice = frappe.db.get_value( \"Purchase Invoice Item\", {\"purchase_order\": doc.name}, \"parent\" ) %}\n\n            <div\n                  style=\"\n                        display: flex;\n                        justify-content: space-between;\n                        align-items: flex-start;\n                  \"\n            >\n                  <div style=\"text-align: left\">\n                        {% if invoice %} \n                        {% set inv = frappe.get_doc(\"Purchase Invoice\", invoice) %}\n                        <p><b>Invoice Number:</b> {{ inv.name }}</p>\n                        <p>\n                              <b>Invoice Date:</b> {{\n                              frappe.format_date(inv.posting_date) }}\n                        </p>\n                        <p>\n                              <b>Payment Terms:</b> {{\n                              inv.payment_terms_template or \"-\" }}\n                        </p>\n                        <p>\n                              <b>Due Date:</b> {{\n                              frappe.format_date(inv.due_date) if inv.due_date\n                              else \"-\" }}\n                        </p>\n                        {% else %}\n                        <p><b>Invoice:</b> Not yet created</p>\n                        {% endif %}\n                  </div>\n            </div>\n            \n            <br>\n\n            <!-- Addresses -->\n            <div\n                  style=\"\n                        display: flex;\n                        justify-content: space-between;\n                        align-items: flex-start;\n                  \"\n            >\n                  <div>\n                        <u><b>Sold To</b></u\n                        ><br />\n                        <p style=\"margin: 0\">\n                              {{ doc.supplier_address or '' }}\n                        </p>\n                        <br />\n                        <p><b>Order Number(s):</b> {{ doc.name }}</p>\n                        <p>\n                              <b>Tracking Number:</b> {{ doc.tracking_id or '\u2014' }}\n                        </p>\n                        <p>\n                              <b>Customer PO(s):</b> {{ doc.tracking_id or '\u2014' }}\n                        </p>\n                  </div>\n                  <div>\n                        <u><b>Shipped To</b></u>\n                        <br />\n                        <p style=\"margin: 0\">\n                              {{ doc.shipping_address_display or '' }}\n                        </p>\n                        <br />\n                        <p><b>Ship Via:</b> {{ doc.carrier_used or '\u2014' }}</p>\n                        <p>\n                              <b>Freight Terms:</b> {{ doc.freight_terms or '\u2014' }}\n                        </p>\n                        <p>\n                              <b>Sales Agent:</b> {{ doc.freight_terms or '\u2014'  }}\n                        </p>\n                  </div>\n            </div>\n\n            <hr style=\"margin: 15px 0\" />\n\n            <div style=\"text-align: center\">\n                  <p style=\"margin: 4px 0\">\n                        <b>Estimated Product Weight:</b>\n                        {{ \"%.2f\"|format(doc.estimated_weight_lbs or 11.76) }}\n                        LBS / {{ \"%.2f\"|format(doc.estimated_weight_kg or 5.33)\n                        }} KG\n                  </p>\n                  <p style=\"margin: 4px 0\">\n                        <b>Actual Product Weight:</b>\n                        {{ \"%.2f\"|format(doc.actual_weight_lbs or 14.00) }} LBS\n                        / {{ \"%.2f\"|format(doc.actual_weight_kg or 6.35) }} KG\n                  </p>\n            </div>\n\n            <hr style=\"margin: 15px 0\" />\n\n            <!-- Totals & Shipment Info -->\n            <div\n                  style=\"\n                        display: flex;\n                        justify-content: space-between;\n                        align-items: flex-start;\n                  \"\n            >\n                  <div style=\"width: 50%\">\n                        <p><b>Total Qty:&nbsp;&nbsp;&nbsp;&nbsp;</b> {{ doc.total_qty or 14 }}</p>\n                        <p>\n                              <b>Backorder Qty::&nbsp;&nbsp;&nbsp;&nbsp;</b> {{ doc.backorder_qty or 0 }}\n                        </p>\n                  </div>\n\n                  <div style=\"width: 50%; text-align: right;\">\n                        <p>\n                              <b>Subtotal:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</b> {{ frappe.format(doc.net_total,\n                              {'fieldtype':'Currency'}) or '$218.40' }}\n                        </p>\n                        <p>\n                              <b>Shipping & Handling:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</b> {{\n                              frappe.format(doc.shipping_amount or 41.20,\n                              {'fieldtype':'Currency'}) }}\n                        </p>\n                        <p>\n                              <b>Additional Charges:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</b> {{\n                              frappe.format(doc.additional_charges or 0,\n                              {'fieldtype':'Currency'}) }}\n                        </p>\n                        <p>\n                              <b>Tax:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</b> {{\n                              frappe.format(doc.total_taxes_and_charges or 0,\n                              {'fieldtype':'Currency'}) }}\n                        </p>\n                        <p>\n                              <b>Total (USD):&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</b>\n                              <span style=\"font-weight: bold\"\n                                    >{{ frappe.format(doc.rounded_total or\n                                    doc.grand_total, {'fieldtype':'Currency'})\n                                    or '$259.60' }}</span\n                              >\n                        </p>\n                        <p>\n                              <b>Balance Due:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</b>\n                              <span style=\"font-weight: bold\"\n                                    >{{ frappe.format(doc.outstanding_amount or\n                                    doc.grand_total, {'fieldtype':'Currency'})\n                                    }}</span\n                              >\n                        </p>\n                  </div>\n            </div>\n\n            <br />\n\n            <!-- Invoice Notes & Remarks -->\n            <h4 style=\"margin-bottom: 4px\">Invoice Notes:</h4>\n            <p style=\"margin-top: 0\">{{ doc.remarks or '' }}</p>\n\n            <h4 style=\"margin-bottom: 4px\">Invoice Remarks:</h4>\n            <p style=\"margin-top: 0\">{{ invoice.remarks or '' }}</p>\n\n            <hr />\n\n            <div style=\"margin-left: 20px; font-size: 12px; text-align: center\">\n                  <p style=\"font-size: 12px\">\n                        <b>\n                              Include your account number on your payment.<br />\n                              Please mail checks and remittances to our lockbox\n                              address below:<br />\n                              Morris Rothenberg & Son Inc., Mail code: 7210<br />\n                              P.O Box 7247<br />\n                              Philadelphia, PA 19170-0001<br />\n                              *************************************************\n                        </b>\n                  </p>\n            </div>\n\n            <hr\n                  style=\"\n                        margin: 20px 0;\n                        border: none;\n                        border-top: 1px solid #ccc;\n                  \"\n            />\n\n            <!-- Disclaimers -->\n            <div style=\"font-size: 11px; color: #444; line-height: 1.5\">\n                  <p>\n                        All claims must be made within five days after receipt\n                        of goods. Merchandise will not be accepted for return\n                        without our written consent and must be freight prepaid.\n                        Embellishment disclaimer: It is the responsibility of\n                        the customer to inspect all products and garments for\n                        any/all quality issues prior to being printed, screened\n                        or embroidered. In no event shall Rothco be liable or\n                        accept returns for damaged or defective merchandise\n                        which has been printed, screened, embroidered, or\n                        altered in any way.\n                  </p>\n\n                  <p>\n                        Disclaimer of warranty: Except as expressly set forth\n                        herein, Rothco makes no warranties, express or implied,\n                        including, without limitation, any warranties of fitness\n                        for a particular use or purpose or merchantability.\n                  </p>\n\n                  <p>\n                        Limitation of liability: In no event shall Rothco be\n                        liable for any incidental, special, indirect, or\n                        consequential damages of any kind, including without\n                        limitation compensation, reimbursement or damages on\n                        account of the loss of present or prospective business,\n                        profits, expenditures, investments or other commitments,\n                        whether made in the establishment, development or\n                        maintenance of business reputation or goodwill, for cost\n                        of substitute products, cost of capital, or for the\n                        claims of any thirdparty, or for any other reason\n                        whatsoever, even if Rothco has been advised of the\n                        possibility of such loss or damage. Any damages that\n                        Rothco is required to pay for any and all causes,\n                        whether for negligence, breach of contract, or\n                        otherwise, and regardless of the form of the action in\n                        the aggregate, shall be limited in amount to the\n                        payments made by the purchaser to Rothco for the\n                        specific products to which Rothco's liability relates.\n                  </p>\n            </div>\n      </div>\n</div>\n",
