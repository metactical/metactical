 "html": "{#- Copy of the native \"WHS receiving\" Purchase Order format. It renders\n    against the PO3 as a Purchase Order: see metactical/procurement_v3/print_format.py -#}\n{%- set doc = po3_print_doc(doc) -%}\n<table class=\"table table-condensed no-border\" style=\"margin-top: 0px;margin-bottom: 0px;padding-top: 0px;\">\n\t<colgroup>\n\t\t<col style=\"width:40%\">\n\t\t<col style=\"width:20%\">\n\t\t<col style=\"width:40%\">\n\t</colgroup> \n\t<tr>\n\t\t<td class =\"text-left\" style = \"border-top:0px dashed black!important;border-left:0px solid black!important;border-right:0px solid black!important;border-bottom:0px solid black!important;padding:0px!important;\" > \n\t\t\t<u><b></b></u>\n\t\t</td>\n\t\t<td class =\"text-left\" style = \"border-top:0px dashed black!important;border-left:0px solid black!important;border-right:0px solid black!important;border-bottom:0px solid black!important;padding:0px!important;\" > \n\t\t\t&nbsp;\n\t\t</td>\n\t\t<td class =\"text-right\" style = \"border-top:0px dashed black!important;border-left:0px solid black!important;border-right:0px solid black!important;border-bottom:0px solid black!important;padding:0px!important;\" > \n\t\t\tPrinting Time : {{ frappe.utils.now_datetime() }}\n\t\t\t<br>\n\t\t\tPO# : {{ doc.name }}\n\t\t</td>\n\t<tr>\n</table>\n<br>\n<br>\n<center><u><b>Purchase Order</b></u>\n<br>\n<br>\n<table class=\"table table-condensed no-border\" style=\"margin-top: 0px;margin-bottom: 0px;padding-top: 0px;\">\n\t<colgroup>\n\t\t<col style=\"width:40%\">\n\t\t<col style=\"width:20%\">\n\t\t<col style=\"width:40%\">\n\t</colgroup> \n\t<tr>\n\t    <td class =\"text-left\" style = \"border-top:0px dashed black!important;border-left:0px solid black!important;border-right:0px solid black!important;border-bottom:0px solid black!important;padding:0px!important;\" > \n\t\t\tSupplier Name : {{ doc.supplier }}\n\t\t</td>\n\t\t<td class =\"text-left\" style = \"border-top:0px dashed black!important;border-left:0px solid black!important;border-right:0px solid black!important;border-bottom:0px solid black!important;padding:0px!important;\" > \n\t\t\t&nbsp;\n\t\t</td>\n\t\t<td class =\"text-left\" style = \"border-top:0px dashed black!important;border-left:0px solid black!important;border-right:0px solid black!important;border-bottom:0px solid black!important;padding:0px!important;\" > \n\t\t    Date : {{ doc.transaction_date }}\n\t\t</td>\n\t<tr>\n\t\t<tr>\n\t\t<td class =\"text-left\" style = \"border-top:0px dashed black!important;border-left:0px solid black!important;border-right:0px solid black!important;border-bottom:0px solid black!important;padding:0px!important;\" > \n\t\t\tWarehouse : {{ doc.items[0].warehouse }}\n\t\t</td>\n\t\t<td class =\"text-left\" style = \"border-top:0px dashed black!important;border-left:0px solid black!important;border-right:0px solid black!important;border-bottom:0px solid black!important;padding:0px!important;\" > \n\t\t\t&nbsp;\n\t\t</td>\n\t\t<td class =\"text-left\" style = \"border-top:0px dashed black!important;border-left:0px solid black!important;border-right:0px solid black!important;border-bottom:0px solid black!important;padding:0px!important;\" > \n\t\t\t\n\t\t</td>\n\t<tr>\n</table>\n<br>\n<br>\n<table class=\"table table-condensed cart no-border\" style=\"font-size:100%;margin-top: 10px;\">\n\t<colgroup>\n\t\t<col style=\"width: 7%\" >\n\t\t<col style=\"width:25% ; height: auto;\">\n\t\t<col style=\"width:35%\">\n\t\t<col style=\"width:10%\">\n\t\t<col style=\"width:07%\">\n\t\t<col style=\"width:15%\">\n\t</colgroup>\n\n\t<tr>\n\t\t<th class =\"text-center\" style = \"border-top:1px solid #D3D3D3;border-left:1px solid #D3D3D3!important;border-right:1px solid #D3D3D3!important;border-bottom:1px solid #D3D3D3!important;padding:1px!important;\">Sr.</th>\n\t\t<th class =\"text-center\" style = \"border-top:1px solid #D3D3D3;border-left:1px solid #D3D3D3!important;border-right:1px solid #D3D3D3!important;border-bottom:1px solid #D3D3D3!important;padding:1px!important;\">Barcode Image</th>\n\t\t<th class =\"text-center\" style = \"border-top:1px solid #D3D3D3;border-left:1px solid #D3D3D3!important;border-right:1px solid #D3D3D3!important;border-bottom:1px solid #D3D3D3!important;padding:1px!important;\">Item Name</th>\n\t\t<th class =\"text-center\" style = \"border-top:1px solid #D3D3D3;border-left:1px solid #D3D3D3!important;border-right:1px solid #D3D3D3!important;border-bottom:1px solid #D3D3D3!important;padding:1px!important;\">RetailSKU</th>\n\t\t<th class =\"text-center\" style = \"border-top:1px solid #D3D3D3;border-left:1px solid #D3D3D3!important;border-right:1px solid #D3D3D3!important;border-bottom:1px solid #D3D3D3!important;padding:1px!important;\">Qty</th>\n\t\t<th class =\"text-center\" style = \"border-top:1px solid ;border-left:1px solid #D3D3D3!important;border-right:1px solid #D3D3D3!important;border-bottom:1px solid #D3D3D3!important;padding:1px!important;\">Item Location</th>\n\t</tr>\n\n\t{% for item in doc.items %}\n\t<tr>\n\t\t<td class=\"text-center\">{{ item.idx }}</td>\n\t\t<td class =\"barcode\" >\n\t\t    {% if item.barcode %}\n                <img src=\"data:image/png;base64,{{get_barcode_for_print_format(item.barcode)}}\" alt=\"Barcode\">\n            {% endif %}\n        </td>\n\t\t<td class =\"text-center\" style = \"border-top:1px solid!important;border-left:1px solid #D3D3D3!important;border-right:1px solid #D3D3D3!important;border-bottom:1px solid #D3D3D3!important;padding:1px!important;word-break: break-word;\"> \n\t\t\t{{ item.item_name }}\n\t\t</td>\n\t\t<td class =\"text-center\" style = \"border-top:1px solid!important;border-left:1px solid #D3D3D3!important;border-right:1px solid #D3D3D3!important;border-bottom:1px solid #D3D3D3!important;padding:1px!important;\"> \n\t\t\t{% if item.ifw_retailskusuffix %}{{ item.ifw_retailskusuffix }}{% endif %} \n\t\t</td>\n\t\t<td class =\"text-center\" style = \"border-top:1px solid!important;border-left:1px solid #D3D3D3!important;border-right:1px solid #D3D3D3!important;border-bottom:1px solid #D3D3D3!important;padding:1px!important;\"> \n\t\t\t{{ item.qty }}\n\t\t</td>\n\t\t<td class =\"text-center\" style = \"border-top:1px solid!important;border-left:1px solid #D3D3D3!important;border-right:1px solid #D3D3D3!important;border-bottom:1px solid #D3D3D3!important;padding:1px!important;\"> \n\t\t\t<!--{% if frappe.get_doc(\"Item\", item.item_code).ifw_location %}{{ frappe.get_doc(\"Item\", item.item_code).ifw_location }}{% endif %}-->\n\t\t\t{{ frappe.db.get_value(\"Item\", item.item_code, \"ifw_location\")|replace(\"|\", \" | <br>\")  }} \n\t\t</td>\n\t</tr>\n\n\n\t{% endfor %}\n</table>\n\n\n<style>\n\np {\n  display: block;\n  margin-top: 1em;\n  margin-bottom: 1em;\n  margin-left: 20em;\n  margin-right: 10em;\n  text-align:right\n}\n</style>\n\n<p><b>Total Qty </b>&nbsp;&nbsp;&nbsp;&nbsp; {{doc.total_qty}} </p>\n<img src=\"data:image/png;base64,{{get_barcode_for_print_format(doc.name)}}\" style=\"width:300px; margin-top: 20px;\" alt=\"Barcode\">\n",
