 "html": "<div style=\"width: 100%\">\n      <!-- Header -->\n      <div\n            style=\"\n                  display: flex;\n                  justify-content: space-between;\n                  align-items: flex-start;\n                  margin-bottom: 10px;\n            \"\n      >\n            <div>\n                  <h4 style=\"margin: 0; padding-bottom: 10px\">\n                        {{doc.supplier}}\n                  </h4>\n                  <p style=\"margin: 0\">{{ doc.address_display or '' }}</p>\n            </div>\n            <div style=\"text-align: right\">\n                  <h2 style=\"margin: 0; color: #333; letter-spacing: 1px\">\n                        INVOICE\n                  </h2>\n                  <p style=\"margin: 3px 0\">\n                        <u\n                              ><b>Invoice Date:</b> {{\n                              frappe.utils.format_date(doc.posting_date)\n                              }}</u\n                        >\n                  </p>\n                  <p style=\"margin: 3px 0\">\n                        <u><b>Invoice No:</b> {{ doc.name }}</u>\n                  </p>\n            </div>\n      </div>\n\n      <hr style=\"border: 1px solid #ccc; margin: 8px 0\" />\n\n      <!-- Billing / Shipping -->\n      <div style=\"width: 100%\">\n            <div style=\"display: flex; justify-content: space-between\">\n                  {% if doc.billing_address_display %}\n                  <div>\n                        <u><b>BILL TO</b></u\n                        ><br />\n                        {{ doc.billing_address_display or '' }}<br />\n                  </div>\n                  {% endif %}\n                  <div style=\"text-align: left\">\n                        <u><b>SHIP TO</b></u\n                        ><br />\n                        {{ doc.shipping_address_display or '' }}<br />\n                  </div>\n            </div>\n      </div>\n\n      <!-- Item Table -->\n      <table style=\"width: 100%; margin-top: 12px; font-size: 12px\">\n            <thead\n                  style=\"\n                        background-color: #f5f5f5;\n                        border-top: 2px solid #222;\n                        border-bottom: 1px solid #ddd;\n                  \"\n            >\n                  <tr>\n                        <th\n                              style=\"\n                                    padding: 8px;\n                                    border-right: 1px solid #ddd;\n                                    text-align: left;\n                              \"\n                        >\n                              DESCRIPTION\n                        </th>\n                        <th\n                              style=\"\n                                    padding: 8px;\n                                    border-right: 1px solid #ddd;\n                                    text-align: center;\n                              \"\n                        >\n                              QTY\n                        </th>\n                        <th\n                              style=\"\n                                    padding: 8px;\n                                    border-right: 1px solid #ddd;\n                                    text-align: center;\n                              \"\n                        >\n                              UNIT PRICE\n                        </th>\n                        <th\n                              style=\"\n                                    padding: 8px;\n                                    border-right: 1px solid #ddd;\n                                    text-align: center;\n                              \"\n                        >\n                              COUNTRY OF ORIGIN\n                        </th>\n                        <th\n                              style=\"padding: 8px; border-right; 1px solid #ddd; text-align: center;\"\n                        >\n                              HS CODE\n                        </th>\n                        <th style=\"padding: 8px; text-align: right\">TOTAL</th>\n                  </tr>\n            </thead>\n            <tbody>\n                  {% for row in doc.items %} {% set item_doc =\n                  frappe.get_doc(\"Item\", row.item_code) %}\n                  <tr style=\"border-bottom: 1px solid #eee\">\n                        <td style=\"padding: 6px\">{{ row.item_name }}</td>\n                        <td style=\"text-align: center; padding: 6px\">\n                              {{ row.qty }}\n                        </td>\n                        <td style=\"text-align: center; padding: 6px\">\n                              {{ frappe.format_value(row.net_rate, {'fieldtype':\n                              'Currency'}) }}\n                        </td>\n                        <td style=\"text-align: center; padding: 6px\">\n                              {{ item_doc.country_of_origin or '' }}\n                        </td>\n                        <td style=\"text-align: center; padding: 6px\">\n                              {{ item_doc.customs_tariff_number or '' }}\n                        </td>\n                        <td style=\"text-align: right; padding: 6px\">\n                              {{ frappe.format_value(row.net_amount,\n                              {'fieldtype': 'Currency'}) }}\n                        </td>\n                  </tr>\n                  {% endfor %}\n            </tbody>\n      </table>\n\n      <!-- Totals Section -->\n      <div\n            style=\"\n                  width: 100%;\n                  display: flex;\n                  justify-content: flex-end;\n                  margin-top: 12px;\n            \"\n      >\n            <div style=\"width: 60%\"></div>\n            <div\n                  style=\"\n                        width: 40%;\n                        background-color: #fafafa;\n                        padding: 8px 12px;\n                  \"\n            >\n                  <div\n                        style=\"\n                              display: flex;\n                              justify-content: space-between;\n                              margin-bottom: 3px;\n                        \"\n                  >\n                        <span style=\"color: #444\">SUBTOTAL:</span>\n                        <span\n                              >{{ frappe.format_value(doc.net_total,\n                              {'fieldtype': 'Currency'}) }}</span\n                        >\n                  </div>\n\n                  <div\n                        style=\"\n                              display: flex;\n                              justify-content: space-between;\n                              margin-bottom: 3px;\n                        \"\n                  >\n                        <span style=\"color: #444\">DISCOUNT:</span>\n                        <span\n                              >{{ frappe.format_value(doc.discount_amount or\n                              0.00, {'fieldtype': 'Currency'}) }}</span\n                        >\n                  </div>\n\n                  <div\n                        style=\"\n                              display: flex;\n                              justify-content: space-between;\n                              margin-bottom: 3px;\n                        \"\n                  >\n                        <span style=\"color: #444\">SUBTOTAL LESS DISCOUNT:</span>\n                        <span\n                              >{{ frappe.format_value(doc.net_total -\n                              (doc.discount_amount or 0.00), {'fieldtype':\n                              'Currency'}) }}</span\n                        >\n                  </div>\n\n                  <div\n                        style=\"\n                              display: flex;\n                              justify-content: space-between;\n                              margin-bottom: 3px;\n                        \"\n                  >\n                        <span style=\"color: #444\">TAX RATE:</span>\n                        <span\n                              >{{ doc.taxes[0].rate|string + '%' if doc.taxes\n                              else '0.00%' }}</span\n                        >\n                  </div>\n\n                  <div\n                        style=\"\n                              display: flex;\n                              justify-content: space-between;\n                              margin-bottom: 3px;\n                        \"\n                  >\n                        <span style=\"color: #444\">TOTAL TAX:</span>\n                        <span\n                              >{{\n                              frappe.format_value(doc.total_taxes_and_charges,\n                              {'fieldtype': 'Currency'}) }}</span\n                        >\n                  </div>\n\n                  <hr\n                        style=\"\n                              border: none;\n                              border-top: 1px solid #ccc;\n                              margin: 6px 0;\n                        \"\n                  />\n\n                  <div\n                        style=\"\n                              display: flex;\n                              justify-content: space-between;\n                              font-size: 13px;\n                        \"\n                  >\n                        <span\n                              style=\"\n                                    font-weight: bold;\n                                    text-decoration: underline;\n                              \"\n                              >BALANCE DUE:</span\n                        >\n                        <span\n                              style=\"\n                                    font-weight: bold;\n                                    text-decoration: underline;\n                                    color: #000;\n                              \"\n                              >{{ frappe.format_value(doc.grand_total,\n                              {'fieldtype': 'Currency'}) }}</span\n                        >\n                  </div>\n            </div>\n      </div>\n</div>\n",
