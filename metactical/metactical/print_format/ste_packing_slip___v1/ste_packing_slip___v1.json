 "html": "<div class=\"print-heading\">\t\t\t\n<h2><div>STE Packing Slip</div><br><small class=\"sub-heading\">{{ doc.name }}</small>\t\t\t\t\n</h2></div>\n\n{% set item_details = get_item_details_for_print(doc.items)|sort(attribute='ifw_retailskusuffix') %}\n\n<table class=\"table table-condensed table-bordered cart no-border\" style=\"font-size:100%;margin-top: 5px;\">\n    <thead>\n        <tr>\n            <th>Retail Sku</th>\n            <th>Item Name</th>\n            <th>Quantity</th>\n            <th>Barcode</th>\n            <th>Location</th>\n            <th>Item Price</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for item in item_details %}\n            <tr>\n                <td>{{ item.ifw_retailskusuffix }}</td>\n                <td>{{ item.item_name }}</td>\n                <td>{{ item.qty }}</td>\n\t<td class =\"barcode\" style=\"padding: 0px 40px !important\">\n\t\t        <img src=\"data:image/png;base64,{{get_barcode_for_print_format(item.barcode)}}\" alt=\"Barcode\">\n                <td>{{ item.ifw_location }}</td>\n                <td>{{ item.item_price }}</td>\n            </tr>\n        {% endfor %}\n    </tbody>\n</table>",
