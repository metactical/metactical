 "html": "<div class=\"head-text\">\n    <center>\n        <b>STE Barcode No</b>\n    </center>\n    <div style=\"text-align:left; float: left; width: 100%;\">\n        <span style=\"float: left;\"><b>Doc #:</b> {{doc.name}}</span>\n    </div>\n<hr style=\"border-top: 1px solid #d1d8dd; float: left; width: 100%;\">\n</div>\n<br>\n<div class=\"row section-break\">\n\t<div class=\"col-xs-12 column-break\">\n                <div style=\"font-size:11px\">\n                    <b>From Warehouse: </b> {{doc.items[0].s_warehouse}} <br>\n                </div>\n\n                <div style=\"font-size:11px\">\n                    <b>To Warehouse:</b> {{doc.items[0].t_warehouse}} <br>\n                </div>\n        </div>\n</div>\n  \n <table class=\"table table-condensed table-hover table-bordered\">\n    <tbody>\n      <tr>\n        <th style=\"font-size: 8px;width: 2.8%;\">Sr</th>\n    \n        <th class=\"text-center\"style=\"font-size: 08px; width:20%\">Barcode</th>\n\n        <th class=\"text-center\" style=\"font-size: 09px; width:31%;\">Item Name</th>\n      </tr>\n    {%- for row in doc.items -%}\n    <tr>\n  \n        <td style=\"text-align: center; font-size: 08px;\"><b>{{ row.idx }}</b></td>\n        \n        <td style=\"text-align: center; font-size: 08px;\">\n             {% set barcodes = frappe.db.get_value('Item Barcode', {'parent': row.item_code}, ['barcode']) %}\n        {% if barcodes %}\n            {{barcodes}}\n        \n        {% elif row.barcode  %}\n            {{ row.barcode }}\n            \n        {% endif %}\n        </td>\n        <td style=\"text-align: center; font-size: 08px;\"><b>{{ row.item_name }}</b></td>\n    </tr>\n    {%- endfor -%}\n    </tbody>\n  </table>",
