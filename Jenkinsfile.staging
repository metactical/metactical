pipeline {
    agent any

    environment {
        APP_ENV = "${env.JOB_NAME.endsWith('-prod') ? 'prod' : 'dev'}"
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Deploying APP_ENV=${APP_ENV} build #${env.BUILD_NUMBER} to ${DEVERP_REMOTE_HOST}"
                checkout scm
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'deverp-server-creds',
                                     usernameVariable: 'USER', passwordVariable: 'PASS'),
                ]) {
                    sh '''
                        ASKPASS="$(mktemp)"
                        printf '#!/bin/sh\\necho "$PASS"\\n' > "$ASKPASS"
                        chmod 700 "$ASKPASS"

                        export SSH_ASKPASS="$ASKPASS"
                        export SSH_ASKPASS_REQUIRE=force
                        export DISPLAY=:0

                        setsid -w ssh -o StrictHostKeyChecking=no \
                            -o PreferredAuthentications=keyboard-interactive,password \
                            -o PubkeyAuthentication=no \
                            -o NumberOfPasswordPrompts=1 \
                            -p $PORT "$USER@$DEVERP_REMOTE_HOST" \
                            "set -e
                            cd $BENCH_DIR

                            echo '--- Pulling metactical ---'
                            git -C apps/metactical fetch upstream
                            git -C apps/metactical reset --hard upstream/version-15-develop

                            echo '--- Checking for schema changes ---'
                            CHANGED=\$(git -C apps/metactical diff HEAD@{1} HEAD --name-only | grep -c \"[.]json\" || true)
                            if [ \"\$CHANGED\" -gt 0 ]; then
                                echo \"\$CHANGED doctype file(s) changed — running migrate in background\"
                                nohup bench --site $SITE_NAME migrate > logs/migrate.log 2>&1 &
                                echo \"Migration running in background (PID: \$!). Tail logs/migrate.log to follow.\"
                            else
                                echo 'No doctype changes — skipping migrate'
                            fi

                            echo '--- Clearing cache ---'
                            bench --site $SITE_NAME clear-cache

                            echo '--- Building assets ---'
                            bench build --app metactical

                            echo '--- Restarting bench ---'
                            echo '$PASS' | sudo -S supervisorctl restart all
                            "
                        RC=$?

                        rm -f "$ASKPASS"
                        exit $RC
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Deployment to ${APP_ENV} complete."
        }
        failure {
            echo "Deployment failed — check the logs above."
        }
    }
}
